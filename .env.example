# === Supabase ===
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret   # Project Settings → API → JWT Settings

# === Database ===
DATABASE_URL=postgresql+asyncpg://postgres:password@db.your-project.supabase.co:5432/postgres

# === Redis / ARQ ===
REDIS_URL=redis://localhost:6379

# === Gemini AI ===
GEMINI_API_KEY=your-gemini-api-key
GEMINI_TAGGING_MODEL=gemini-2.0-flash
GEMINI_SUGGESTION_MODEL=gemini-2.0-flash

# === Background Removal ===
REMOVEBG_API_KEY=your-removebg-api-key   # optional — fallback nếu rembg fail

# === Weather ===
OPENWEATHERMAP_API_KEY=your-openweathermap-api-key

# === App ===
APP_ENV=development   # development | production
SECRET_KEY=your-random-secret-key-32-chars-min

# === Mobile (Expo) — đặt trong mobile/.env.local ===
# EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# EXPO_PUBLIC_API_URL=http://localhost:8000
